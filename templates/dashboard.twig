{% extends 'layout.twig' %}
{% block title %}Dashboard{% endblock %}
{% block content %}
    <h1 class="text-2xl font-bold mb-4">Dashboard</h1>

    {# Alerts Section #}
{% if alerts is defined and alerts|length > 0 %}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-2">Overspending Alerts</h2>
        {# TODO: you have below examples for both success and failure messages #}
        {# TODO: customize the markup below for the actual alerts #}
         {% for alert in alerts %}
        <div class="bg-red-900/50 border border-red-700 rounded-lg p-4 mb-2 text-red-300">
            {{ alert }}
        </div>
    {% endfor %}
    </section>
    {% endif %}

    <section>
        <h2 class="text-xl font-bold mb-4">Monthly Expenses Summary</h2>
        <form action="" method="get" class="mb-4 flex gap-4 items-center">
            {# TODO: remove mock data below, pass actual years having expenses from the controller #}
        <div>
            <label for="year" class="block text-sm text-gray-300 font-bold mb-1">Year</label>
            <select name="year" id="year" class="bg-gray-700 text-gray-100 rounded px-3 py-2">
                {% for y in years %}
                    <option value="{{ y }}" {% if y == year %}selected{% endif %}>{{ y }}</option>
                {% endfor %}
            </select>
        </div>

            {# TODO: add the "selected" attribute to the current displayed month #}
        <div>
            <label for="month" class="block text-sm text-gray-300 font-bold mb-1">Month</label>
            <select name="month" id="month" class="bg-gray-700 text-gray-100 rounded px-3 py-2">
                {% for m in 1..12 %}
                    <option value="{{ m }}" {% if m == month %}selected{% endif %}>{{ m }}</option>
                {% endfor %}
            </select>
        </div>
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                Show summary
            </button>
        </form>

        <div class="mt-6">
            <h3 class="text-lg font-bold mb-2">Total expenditure</h3>
            <div class="bg-gray-800 rounded-lg p-6">
                <div class="text-4xl font-bold text-green-400 mb-2">€{{ totalForMonth|number_format(2) }}</div>
                <div class="text-gray-400">for {{ month }}/{{ year }}</div>
            </div>
        </div>

        {% set colors = ['orange','lime','blue','amber','green','yellow','violet','emerald','purple','teal','fuchsia'] %}
        {# TODO: replace the static data below with actual per-category totals passed from the controller #}
            {% set color = colors[loop.index0 % colors|length] %}
        {% set percentage = (amount / totalForMonth * 100)|round(0, 'ceil') %}
        <div class="relative mb-2">
            <div class="bg-{{ color }}-600 h-8 rounded" style="width: {{ percentage }}%">
                <span class="absolute inset-0 flex items-center justify-start pl-4 text-white font-bold">
                    {{ category|capitalize }}: €{{ amount|number_format(2) }}
                </span>
            </div>
        </div>
    {% endfor %}

        <div class="mt-6">
            <h3 class="text-lg font-bold mb-2">Per-category <strong>totals</strong> for month 5 of 2025</h3>
            <div class="space-y-4 mb-2">
                {% for category,data in totalsForCategories %}
                    <div class="relative">
                        <div class="bg-{{ colors[loop.index0 % colors|length] }}-600 h-8 rounded"
                             style="width: {{ data.percentage }}%">
                            <span class="absolute inset-0 flex items-center justify-start pl-4 text-white font-bold">{{ category }}: {{ data.value }} €</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# TODO: follow the example above and replicate the markup and twig logic for the averages below #}
        <div class="mt-6">
            <h3 class="text-lg font-bold mb-2">Per-category <strong>averages</strong> for month 5 of 2025</h3>
            <div class="space-y-4 mb-2">
                {% for category, avg in averagesForCategories %}
        {% set width = (avg / 500 * 100)|round(0, 'ceil') %}
        <div class="relative mb-2">
            <div class="bg-blue-600 h-8 rounded" style="width: {{ width }}%">
                <span class="absolute inset-0 flex items-center justify-start pl-4 text-white font-bold">
                    {{ category|capitalize }}: €{{ avg|number_format(2) }}
                </span>
            </div>
        </div>
    {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}
