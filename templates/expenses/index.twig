{% extends 'layout.twig' %}
{% block title %}Expenses{% endblock %}
{% block content %}

    {# TODO: remove mock data below, pass real expenses from the controller action #}

    <h1 class="text-2xl font-bold mb-4">Expenses</h1>
    <!-- Filter Form -->
<form method="get" class="flex gap-2 mb-4">
    <select name="year" class="bg-gray-800 text-white px-3 py-2 rounded">
        {% for y in years %}
            <option value="{{ y }}" {% if y == year %}selected{% endif %}>{{ y }}</option>
        {% endfor %}
    </select>
    <select name="month" class="bg-gray-800 text-white px-3 py-2 rounded">
        {% for m in 1..12 %}
            <option value="{{ m }}" {% if m == month %}selected{% endif %}>{{ m }}</option>
        {% endfor %}
    </select>
    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Filter</button>
    <a href="/expenses/create" class="ml-auto bg-green-600 text-white px-4 py-2 rounded">Add</a>
</form>

<!-- Expenses Table -->
<table class="w-full text-left bg-gray-800 rounded">
    <thead>
        <tr class="text-gray-300 border-b border-gray-700">
            <th class="py-2 px-3">Description</th>
            <th class="py-2 px-3">Amount</th>
            <th class="py-2 px-3">Category</th>
            <th class="py-2 px-3">Date</th>
            <th class="py-2 px-3">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for e in expenses %}
        <tr class="border-b border-gray-700">
            <td class="py-2 px-3">{{ e.description }}</td>
            <td class="py-2 px-3">{{ e.amountCents / 100 | number_format(2) }} €</td>
            <td class="py-2 px-3">{{ e.category }}</td>
            <td class="py-2 px-3">{{ e.date|date('Y-m-d') }}</td>
            <td class="py-2 px-3">
                <a href="/expenses/{{ e.id }}/edit" class="text-blue-400 hover:underline">Edit</a>
                |
                <a href="/expenses/{{ e.id }}/delete" class="text-red-400 hover:underline">Delete</a>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="5" class="py-4 text-center text-gray-500">No expenses found.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<!-- Pagination -->
<div class="flex items-center justify-between mt-4 text-gray-300">
    {% if hasPrev %}
        <a href="?year={{ year }}&month={{ month }}&page={{ page - 1 }}" class="text-blue-400 hover:underline">Previous</a>
    {% else %}
        <span></span>
    {% endif %}

    <span>Total: {{ total }}</span>

    {% if hasNext %}
        <a href="?year={{ year }}&month={{ month }}&page={{ page + 1 }}" class="text-blue-400 hover:underline">Next</a>
    {% endif %}
</div>
{% endblock %}

   